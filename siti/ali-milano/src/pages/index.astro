---
import Base from '../layouts/Base.astro';
import ProssimiEventi from '@condiviso/components/ProssimiEventi.astro';
import ModuloContatti from '@condiviso/components/ModuloContatti.astro';
import home from '@impostazioni/home.json';
import sito from '@impostazioni/sito.json';
import { md, CATEGORIE, pubblicazioniDelSito } from '@condiviso/lib/utili';

const pubblicazioni = await pubblicazioniDelSito();
const conteggio = (c: string) => pubblicazioni.filter((p) => p.data.categoria === c).length;
const ultime = pubblicazioni
  .filter((p) => p.data.immagine)
  .sort((a, b) => b.data.data.localeCompare(a.data.data))
  .slice(0, 3);

const scorciatoie = [
  ...Object.entries(CATEGORIE).map(([k, nome]) => ({ nome, url: `/pubblicazioni/#${k}`, nota: `${conteggio(k)} titoli` })),
  { nome: 'Documenti', url: '/consultorio/#documenti', nota: 'Testi da scaricare' },
  { nome: 'Locandine', url: '/pubblicazioni/#locandine', nota: 'Programmi degli anni' },
];
---
<Base>
  <section class="eroe">
    <div class="contenitore eroe__griglia">
      <div class="eroe__testo">
        <p class="occhiello">Dal 1998 a Milano</p>
        <h1>{home.titolo}</h1>
        <hr class="filetto" />
        <div class="eroe__intro" set:html={md(home.introduzione)} />
        <div class="eroe__azioni">
          <a class="bottone" href="/chi-siamo/">Scopri di più</a>
          <a class="bottone bottone--chiaro" href="/appuntamenti/">Appuntamenti</a>
        </div>
      </div>
      <div class="eroe__immagine">
        <img src={home.immagine} alt="La sede dell’associazione in piazza Aspromonte" width="734" height="1014" />
      </div>
    </div>
  </section>

  <section class="sezione sezione--carta">
    <div class="contenitore due-colonne">
      <div>
        <p class="occhiello">Calendario</p>
        <h2>Prossimi appuntamenti</h2>
        <p>Seminari, giornate di studio e presentazioni dell’Associazione lacaniana internazionale Milano.</p>
        <p><a href="/appuntamenti/">Tutti gli appuntamenti →</a><br /><a href="/appuntamenti.ics">Aggiungi al tuo calendario</a></p>
      </div>
      <ProssimiEventi limite={4} />
    </div>
  </section>

  <section class="sezione">
    <div class="contenitore">
      <p class="occhiello">Archivio</p>
      <h2 class="senza-margine">Pubblicazioni</h2>
      <ul class="scorciatoie">
        {scorciatoie.map((s) => (
          <li><a href={s.url}><strong>{s.nome}</strong><span>{s.nota}</span></a></li>
        ))}
      </ul>
      <div class="griglia-schede">
        {ultime.map((p) => (
          <a class="scheda" href={`/pubblicazioni/${p.id}/`}>
            <img src={p.data.immagine} alt="" loading="lazy" />
            <div class="scheda__corpo">
              <span class="etichetta">{CATEGORIE[p.data.categoria]}</span>
              <h3>{p.data.titolo}</h3>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="consultorio">
    <div class="contenitore consultorio__griglia">
      <div>
        <p class="occhiello occhiello--chiaro">Consultorio di psicoanalisi</p>
        <h2>{home.consultorio_titolo}</h2>
      </div>
      <div>
        <div set:html={md(home.consultorio_testo)} />
        <a class="bottone bottone--bianco" href="/consultorio/">Vai al consultorio</a>
      </div>
    </div>
  </section>

  <section class="sezione">
    <div class="contenitore due-colonne">
      <div>
        <p class="occhiello">Contatti</p>
        <h2>Scrivici</h2>
        <p>{sito.indirizzo}<br /><span class="grigio">{sito.come_arrivare}</span></p>
        <p>Tel. <a href={`tel:${sito.telefono.replace(/\s/g, '')}`}>{sito.telefono}</a><br /><a href={`mailto:${sito.email}`}>{sito.email}</a></p>
        <p><a href={sito.mappa} rel="noopener">Apri la mappa →</a></p>
      </div>
      <ModuloContatti />
    </div>
  </section>
</Base>

<style>
  .eroe { background: var(--carta) url('/uploads/2022/01/circle-background-pattern.png') left -180px bottom -220px / 640px no-repeat; border-bottom: 1px solid var(--linea); }
  .eroe__griglia { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(32px, 6vw, 80px); align-items: center; padding: clamp(40px, 7vw, 88px) 0; }
  .eroe h1 { text-transform: uppercase; font-size: clamp(2rem, 4.2vw, 3.2rem); line-height: 1.1; hyphens: manual; }
  .eroe__intro { font-size: 1.08rem; max-width: 560px; }
  .eroe__intro :global(a) { font-weight: 600; }
  .eroe__azioni { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
  .eroe__immagine img { width: 100%; max-height: 620px; object-fit: cover; border-radius: var(--raggio); box-shadow: 24px 24px 0 var(--accento-chiaro); }

  .due-colonne { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(32px, 6vw, 72px); align-items: start; }
  .due-colonne h2 { margin-top: 0; }
  .senza-margine { margin-top: 0; }
  .grigio { color: var(--grigio); font-size: 0.95rem; }

  .scorciatoie { list-style: none; padding: 0; margin: 28px 0 40px; display: grid; grid-template-columns: repeat(6, 1fr); gap: 12px; }
  .scorciatoie a { display: flex; flex-direction: column; gap: 2px; padding: 16px 18px; border: 1px solid var(--linea); border-radius: var(--raggio); text-decoration: none; color: var(--inchiostro); transition: .15s; }
  .scorciatoie a:hover { border-color: var(--accento); background: var(--accento-chiaro); }
  .scorciatoie strong { font-family: var(--titoli); }
  .scorciatoie span { font-size: 0.85rem; color: var(--grigio); }

  .consultorio { background: var(--accento) url('/uploads/2022/01/circle-background-pattern.png') right -160px center / 560px no-repeat; color: #fff; padding: clamp(56px, 8vw, 96px) 0; }
  .consultorio h2 { color: #fff; margin: 0; font-size: clamp(1.6rem, 3vw, 2.3rem); }
  .occhiello--chiaro { color: #f3cfcf; }
  .consultorio__griglia { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 72px); align-items: start; }
  .consultorio :global(p) { font-size: 1.05rem; }

  @media (max-width: 960px) {
    .scorciatoie { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 860px) {
    .eroe__griglia, .due-colonne, .consultorio__griglia { grid-template-columns: 1fr; }
    .eroe__immagine { order: -1; }
    .eroe__immagine img { max-height: 340px; box-shadow: none; }
  }
  @media (max-width: 520px) {
    .scorciatoie { grid-template-columns: repeat(2, 1fr); }
  }
</style>
