---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Ellissi from '../components/Ellissi.astro';
import ProssimiEventi from '@condiviso/components/ProssimiEventi.astro';
import ModuloContatti from '@condiviso/components/ModuloContatti.astro';
import home from '@impostazioni/home.json';
import sito from '@impostazioni/sito.json';
import { md, CATEGORIE, pubblicazioniDelSito } from '@condiviso/lib/utili';

const pubblicazioni = await pubblicazioniDelSito();
const categorie = (['libri', 'articoli', 'seminari', 'dossier'] as const)
  .map((k) => ({ k, nome: CATEGORIE[k], quante: pubblicazioni.filter((p) => p.data.categoria === k).length }))
  .filter((c) => c.quante);
const ultime = pubblicazioni.filter((p) => p.data.immagine).slice(0, 3);

// Dalle pagine: i tre principi del Consultorio e la frase di "Chi siamo"
const consultorio = (await getEntry('pagine', 'consultorio'))!;
const principi = [...consultorio.body!.matchAll(/^- (.+)$/gm)].map((m) => m[1]).slice(0, 3);
const chiSiamo = (await getEntry('pagine', 'chi-siamo'))!;
const scommessa = chiSiamo.body!.match(/^> (.+)$/m)?.[1];
---
<Base>
  <section class="apertura">
    <div class="contenitore apertura__griglia">
      <div class="apertura__testo">
        <h1>Associazione lacaniana internazionale <span>Milano</span></h1>
        <div class="apertura__intro" set:html={md(home.introduzione.split('\n\n')[0])} />
        <div class="apertura__azioni">
          <a class="bottone" href="/appuntamenti/">Seminari e appuntamenti</a>
          <a class="bottone bottone--chiaro" href="/consultorio/">Il Consultorio</a>
        </div>
      </div>
      <div class="apertura__figura">
        <Ellissi />
      </div>
    </div>
  </section>

  <section class="sezione sezione--carta">
    <div class="contenitore calendario">
      <div>
        <h2>Prossimi appuntamenti</h2>
        <p>Seminari, insegnamenti del sabato, giornate di studio e presentazioni di libri, in sede e alla Casa della Cultura.</p>
        <p class="link"><a href="/appuntamenti/">Calendario e archivio</a><br /><a href="/appuntamenti.ics">Aggiungi al tuo calendario</a></p>
      </div>
      <ProssimiEventi limite={4} />
    </div>
  </section>

  <section class="consultorio">
    <div class="contenitore consultorio__griglia">
      <div>
        <p class="consultorio__nome">Consultorio di psicoanalisi</p>
        <h2>“Edipo in città”</h2>
        <div class="consultorio__testo" set:html={md(home.consultorio_testo)} />
        <a class="bottone bottone--bianco" href="/consultorio/">Come funziona il Consultorio</a>
      </div>
      <div class="consultorio__lato">
        <p class="consultorio__intro">Il Consultorio accoglie la domanda di chi soffre e, in coerenza con il discorso psicoanalitico:</p>
        <ul>{principi.map((p) => <li>{p}</li>)}</ul>
        <p class="consultorio__recapito">
          Si riceve su appuntamento in {sito.indirizzo}<br />
          Tel. <a href={`tel:${sito.telefono.replace(/\s/g, '')}`}>{sito.telefono}</a> · <a href={`mailto:${sito.email_consultorio}`}>{sito.email_consultorio}</a>
        </p>
      </div>
    </div>
  </section>

  {scommessa && (
    <section class="sezione scommessa">
      <div class="contenitore">
        <blockquote>
          <p>{scommessa}</p>
        </blockquote>
        <p class="link"><a href="/chi-siamo/">La storia dell’associazione</a></p>
      </div>
    </section>
  )}

  <section class="sezione sezione--carta">
    <div class="contenitore pubblicazioni">
      <div>
        <h2>Pubblicazioni</h2>
        <ul class="indice">
          {categorie.map((c) => (
            <li><a href={`/pubblicazioni/#${c.k}`}><span>{c.nome}</span><span class="numero">{c.quante}</span></a></li>
          ))}
          <li><a href="/consultorio/#documenti"><span>Documenti da scaricare</span><span class="numero">PDF</span></a></li>
          <li><a href="/pubblicazioni/#locandine"><span>Locandine dei programmi</span><span class="numero"></span></a></li>
        </ul>
      </div>
      <div class="ultime">
        {ultime.map((p) => (
          <a class="scheda" href={`/pubblicazioni/${p.id}/`}>
            <img src={p.data.immagine} alt="" loading="lazy" />
            <div class="scheda__corpo">
              <span class="etichetta">{CATEGORIE[p.data.categoria]}</span>
              <h3>{p.data.titolo}</h3>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sezione">
    <div class="contenitore contatti">
      <div>
        <h2>Scrivici</h2>
        <p>{sito.indirizzo}<br /><span class="grigio">{sito.come_arrivare}</span></p>
        <p>Tel. <a href={`tel:${sito.telefono.replace(/\s/g, '')}`}>{sito.telefono}</a><br /><a href={`mailto:${sito.email}`}>{sito.email}</a></p>
        <p><a href={sito.mappa} rel="noopener">Apri la mappa</a></p>
      </div>
      <ModuloContatti />
    </div>
  </section>
</Base>

<style>
  .apertura { background: var(--fondo); border-bottom: 1px solid var(--linea); overflow: hidden; }
  .apertura__griglia { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: clamp(24px, 5vw, 64px); align-items: center; padding: clamp(48px, 8vw, 104px) 0 clamp(40px, 6vw, 88px); }
  .apertura h1 { font-size: clamp(2.9rem, 6.6vw, 5.4rem); line-height: 0.98; font-weight: 500; letter-spacing: -0.02em; margin: 0; font-variation-settings: 'opsz' 96; }
  .apertura h1 span { display: block; font-style: italic; color: var(--accento); }
  .apertura__intro { font-size: 1.12rem; max-width: 52ch; margin-top: 28px; }
  .apertura__intro :global(a) { font-weight: 600; }
  .apertura__azioni { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
  .apertura__figura { max-width: 440px; width: 100%; justify-self: center; }

  .calendario { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(32px, 6vw, 72px); align-items: start; }
  .calendario h2 { margin-top: 0; }
  .link { margin-top: 20px; }

  .consultorio { background: var(--vino); color: #f3e4e5; padding: clamp(56px, 8vw, 104px) 0; }
  .consultorio__griglia { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 80px); align-items: start; }
  .consultorio__nome { font: italic 500 1.15rem/1.3 var(--titoli); color: #e6b6ba; margin: 0 0 4px; }
  .consultorio h2 { color: #fff; margin: 0 0 24px; font-size: clamp(2.2rem, 4.4vw, 3.4rem); }
  .consultorio__testo { font-size: 1.08rem; }
  .consultorio__testo :global(strong) { color: #fff; }
  .consultorio__lato { border-left: 1px solid rgb(255 255 255 / .2); padding-left: clamp(20px, 3vw, 40px); }
  .consultorio__intro { color: #e6c9cb; }
  .consultorio ul { list-style: none; padding: 0; margin: 0 0 28px; }
  .consultorio li { font: 500 1.3rem/1.35 var(--titoli); font-variation-settings: 'opsz' 28; color: #fff; padding: 14px 0; border-bottom: 1px solid rgb(255 255 255 / .16); }
  .consultorio__recapito { font-size: 0.97rem; color: #e6c9cb; }
  .consultorio a:not(.bottone) { color: #fff; }

  .scommessa { text-align: left; }
  .scommessa blockquote { margin: 0; padding-left: clamp(16px, 3vw, 40px); border-left: 3px solid var(--accento); }
  .scommessa blockquote p { max-width: 34ch; font: italic 500 clamp(1.5rem, 2.8vw, 2.3rem)/1.28 var(--titoli); font-variation-settings: 'opsz' 60; color: var(--inchiostro); margin: 0; text-wrap: pretty; }

  .pubblicazioni { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(32px, 6vw, 72px); align-items: start; }
  .pubblicazioni h2 { margin-top: 0; }
  .indice { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--inchiostro); }
  .indice a { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--linea); text-decoration: none; color: var(--inchiostro); font: 500 1.25rem/1.3 var(--titoli); font-variation-settings: 'opsz' 24; }
  .indice a:hover { color: var(--accento); }
  .numero { font: 500 0.95rem/1 var(--corpo); color: var(--grigio); font-variant-numeric: tabular-nums; }
  .ultime { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }

  .contatti { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(32px, 6vw, 72px); }
  .contatti h2 { margin-top: 0; }
  .grigio { color: var(--grigio); font-size: 0.95rem; }

  @media (max-width: 960px) {
    .ultime { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 860px) {
    .apertura__griglia, .calendario, .consultorio__griglia, .pubblicazioni, .contatti { grid-template-columns: 1fr; }
    .apertura__figura { max-width: 300px; order: -1; }
    .consultorio__lato { border-left: 0; padding-left: 0; border-top: 1px solid rgb(255 255 255 / .2); padding-top: 24px; }
  }
  @media (max-width: 520px) {
    .ultime { grid-template-columns: 1fr; }
  }
</style>
