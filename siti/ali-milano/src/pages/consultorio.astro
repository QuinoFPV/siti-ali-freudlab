---
import { getCollection, getEntry, render } from 'astro:content';
import Pagina from '../layouts/Pagina.astro';
import ModuloContatti from '@condiviso/components/ModuloContatti.astro';
import sito from '@impostazioni/sito.json';
import { dataBreve } from '@condiviso/lib/utili';

const pagina = (await getEntry('pagine', 'consultorio'))!;
const { Content } = await render(pagina);
const documenti = (await getCollection('documenti', (d) => d.data.sezione === 'consultorio' && d.data.siti.includes('ali-milano')))
  .sort((a, b) => b.data.data.localeCompare(a.data.data));
const descrizioni = await Promise.all(documenti.map(async (d) => (await render(d)).Content));
---
<Pagina titolo={pagina.data.titolo} sottotitolo={pagina.data.sottotitolo} occhiello="Consultorio di psicoanalisi">
  <section class="sezione">
    <div class="contenitore consultorio">
      <div class="prosa"><Content /></div>
      <aside class="recapito">
        <h2>Come contattarci</h2>
        <p>Il consultorio ha sede presso l’Associazione lacaniana internazionale Milano.</p>
        <p><strong>{sito.indirizzo}</strong><br />{sito.come_arrivare}</p>
        <p>Tel. <a href={`tel:${sito.telefono.replace(/\s/g, '')}`}>{sito.telefono}</a><br /><a href={`mailto:${sito.email_consultorio}`}>{sito.email_consultorio}</a></p>
        <p class="grigio">Si riceve su appuntamento. {sito.consultorio_roma}.</p>
      </aside>
    </div>
  </section>

  <section class="sezione sezione--carta" id="documenti">
    <div class="contenitore">
      <h2>Documenti</h2>
      <div class="documenti">
        {documenti.map((d, i) => {
          const Descrizione = descrizioni[i];
          return (
            <article class="documento">
              <h3>{d.data.titolo}</h3>
              <p class="autore">{d.data.autore}{d.data.autore && ' · '}{dataBreve(d.data.data)}</p>
              <div class="descrizione"><Descrizione /></div>
              <a class="bottone bottone--chiaro" href={d.data.file} download>Scarica il PDF</a>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="sezione">
    <div class="stretto">
      <h2>Prenota un appuntamento</h2>
      <p>Scrivici per avere maggiori informazioni o per fissare un primo colloquio.</p>
      <ModuloContatti oggetto="Richiesta per il Consultorio Edipo in città" />
    </div>
  </section>
</Pagina>

<style>
  .consultorio { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: clamp(32px, 5vw, 64px); align-items: start; }
  .recapito { position: sticky; top: 100px; padding: 24px; background: var(--carta); border-top: 3px solid var(--accento); border-radius: var(--raggio); font-size: 0.97rem; }
  .recapito h2 { margin-top: 0; font-size: 1.2rem; }
  .grigio { color: var(--grigio); font-size: 0.9rem; }
  #documenti h2 { margin-top: 0; }
  .documenti { display: grid; gap: 20px; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
  .documento { display: flex; flex-direction: column; padding: 24px; background: var(--superficie); border: 1px solid var(--linea); border-radius: var(--raggio); }
  .documento h3 { margin: 0 0 6px; font-size: 1.1rem; }
  .autore { color: var(--accento); font-size: 0.88rem; font-weight: 600; }
  .descrizione { color: var(--grigio); font-size: 0.95rem; flex: 1; }
  .documento .bottone { align-self: flex-start; }
  @media (max-width: 900px) {
    .consultorio { grid-template-columns: 1fr; }
    .recapito { position: static; }
  }
</style>
