---
import type { CollectionEntry } from 'astro:content';
import { giorno, mese, anno, orario } from '../lib/utili';

interface Props {
  evento: CollectionEntry<'eventi'>;
}
const { evento } = Astro.props;
const e = evento.data;
---
<a class="evento" href={`/appuntamenti/${evento.id}/`} data-fine={e.fine ?? e.inizio}>
  <time class="evento__data" datetime={e.inizio}>
    <span class="evento__giorno">{giorno(e.inizio)}</span>
    <span class="evento__mese">{mese(e.inizio)} {anno(e.inizio)}</span>
  </time>
  <span class="evento__testo">
    <strong>{e.titolo}</strong>
    <span>{orario(e)}{e.luogo && ` · ${e.luogo}`}</span>
  </span>
  <span class="evento__freccia" aria-hidden="true">→</span>
</a>

<style>
  .evento {
    display: grid; grid-template-columns: 92px 1fr auto; gap: 20px; align-items: center;
    padding: 18px 20px; background: #fff;
    border: 1px solid var(--linea); border-radius: var(--raggio);
    text-decoration: none; color: inherit; transition: border-color .15s;
  }
  .evento:hover { border-color: var(--accento); color: inherit; }
  .evento__data { display: flex; flex-direction: column; align-items: center; padding-right: 20px; border-right: 1px solid var(--linea); }
  .evento__giorno { font: 700 2rem/1 var(--titoli); color: var(--accento); }
  .evento__mese { font: 600 0.72rem/1.4 var(--titoli); letter-spacing: 0.08em; text-transform: uppercase; color: var(--grigio); white-space: nowrap; margin-top: 4px; }
  .evento__testo { display: flex; flex-direction: column; gap: 2px; }
  .evento__testo strong { font: 600 1.05rem/1.35 var(--titoli); color: var(--inchiostro); }
  .evento__testo span { color: var(--grigio); font-size: 0.92rem; }
  .evento__freccia { color: var(--accento); font-size: 1.3rem; }
  @media (max-width: 560px) {
    .evento { grid-template-columns: 70px 1fr; gap: 14px; padding: 14px; }
    .evento__data { padding-right: 14px; }
    .evento__giorno { font-size: 1.6rem; }
    .evento__freccia { display: none; }
  }
</style>
