---
import sito from '@impostazioni/sito.json';

interface Props {
  oggetto?: string;
}
const { oggetto = 'Richiesta dal sito ALI Milano' } = Astro.props;
// Finché non è impostato un servizio per i moduli (es. Formspree), il modulo apre il programma di posta
const azione = sito.modulo_contatti || `mailto:${sito.email}`;
const metodo = sito.modulo_contatti ? 'post' : 'get';
---
<form class="modulo" action={azione} method={metodo} enctype={sito.modulo_contatti ? undefined : 'text/plain'}>
  <input type="hidden" name="subject" value={oggetto} />
  <label>Nome<input name="nome" autocomplete="name" required /></label>
  <label>Email<input name="email" type="email" autocomplete="email" required /></label>
  <label class="largo">Messaggio<textarea name="messaggio" rows="5" required></textarea></label>
  <div class="largo modulo__fondo">
    <button class="bottone" type="submit">Invia</button>
    {!sito.modulo_contatti && <small>Versione demo: il messaggio viene preparato nel tuo programma di posta.</small>}
  </div>
</form>

<style>
  .modulo { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .largo { grid-column: 1 / -1; }
  label { display: flex; flex-direction: column; gap: 6px; font: 600 0.8rem/1.2 var(--titoli); letter-spacing: 0.06em; text-transform: uppercase; color: var(--inchiostro); }
  input, textarea {
    font: 400 1rem/1.5 var(--corpo); color: var(--testo);
    padding: 12px 14px; border: 1px solid #cfc8c1; border-radius: var(--raggio); background: #fff;
  }
  input:focus, textarea:focus { outline: 2px solid var(--accento); outline-offset: 0; border-color: var(--accento); }
  .modulo__fondo { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; }
  small { color: var(--grigio); }
  @media (max-width: 560px) { .modulo { grid-template-columns: 1fr; } }
</style>
