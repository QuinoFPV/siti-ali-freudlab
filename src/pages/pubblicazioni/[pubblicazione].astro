---
import { getCollection, render } from 'astro:content';
import Pagina from '../../layouts/Pagina.astro';
import { CATEGORIE, dataBreve } from '../../lib/utili';

export async function getStaticPaths() {
  return (await getCollection('pubblicazioni')).map((p) => ({ params: { pubblicazione: p.id }, props: { p } }));
}
const { p } = Astro.props;
const { Content } = await render(p);
const d = p.data;
---
<Pagina titolo={d.titolo} occhiello={CATEGORIE[d.categoria]}>
  <article class="sezione">
    <div class="contenitore pubblicazione">
      {d.immagine && <img class="copertina" src={d.immagine} alt="" />}
      <div class="prosa">
        <p class="data">Pubblicato il {dataBreve(d.data)}</p>
        <Content />
      </div>
    </div>
    <p class="contenitore indietro"><a href={`/pubblicazioni/#${d.categoria}`}>← {CATEGORIE[d.categoria]}</a></p>
  </article>
</Pagina>

<style>
  .pubblicazione { display: grid; grid-template-columns: minmax(0, 340px) minmax(0, 720px); gap: clamp(32px, 5vw, 64px); align-items: start; }
  .pubblicazione:not(:has(.copertina)) { grid-template-columns: minmax(0, 760px); justify-content: center; }
  .copertina { position: sticky; top: 100px; width: 100%; border-radius: var(--raggio); border: 1px solid var(--linea); }
  .data { color: var(--grigio); font-size: 0.92rem; }
  .indietro { margin-top: 48px; }
  @media (max-width: 860px) {
    .pubblicazione { grid-template-columns: 1fr; }
    .copertina { position: static; max-width: 420px; }
  }
</style>
