---
import '../styles/global.css';
import sito from '../content/impostazioni/sito.json';

interface Props {
  titolo?: string;
  descrizione?: string;
}
const { titolo, descrizione = sito.descrizione } = Astro.props;
const titoloCompleto = titolo ? `${titolo} | ${sito.sigla}` : `${sito.sigla} | ${sito.nome}`;
const percorso = Astro.url.pathname;

const menu = [
  {
    nome: 'L’Associazione', url: '/chi-siamo/',
    sotto: [
      { nome: 'Chi siamo', url: '/chi-siamo/' },
      { nome: 'Statuto', url: '/statuto/' },
      { nome: 'Soci', url: '/soci/' },
      { nome: 'Storico attività', url: '/storico-attivita/' },
    ],
  },
  { nome: 'Appuntamenti', url: '/appuntamenti/' },
  { nome: 'Pubblicazioni', url: '/pubblicazioni/' },
  { nome: 'Consultorio', url: '/consultorio/' },
  { nome: 'Introduzione alla psicoanalisi', url: '/introduzione-alla-psicoanalisi/' },
  { nome: 'Contatti', url: '/contatti/' },
];
const attivo = (v: { url: string; sotto?: { url: string }[] }) =>
  percorso.startsWith(v.url) || v.sotto?.some((s) => percorso.startsWith(s.url));
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titoloCompleto}</title>
    <meta name="description" content={descrizione} />
    <meta property="og:title" content={titoloCompleto} />
    <meta property="og:description" content={descrizione} />
    <meta property="og:site_name" content={sito.nome} />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/uploads/2022/01/cropped-FAVICON-192x192.jpg" />
    <link rel="alternate" type="text/calendar" title="Appuntamenti ALI Milano" href="/appuntamenti.ics" />
  </head>
  <body>
    <a class="salta" href="#contenuto">Vai al contenuto</a>
    <header class="intestazione">
      <div class="contenitore intestazione__riga">
        <a href="/" class="logo" aria-label={`${sito.nome} – home`}>
          <img src="/uploads/2022/01/logo_menu-1.jpg" alt="" width="397" height="149" />
        </a>
        <button class="hamburger" type="button" aria-expanded="false" aria-controls="menu-principale" aria-label="Menu">
          <span></span><span></span><span></span>
        </button>
          <nav id="menu-principale" class="navigazione" aria-label="Menu principale">
            <ul class="menu">
              {menu.map((voce) => (
                <li class={voce.sotto ? 'ha-sotto' : ''}>
                  <a href={voce.url} aria-current={attivo(voce) ? 'page' : undefined}>{voce.nome}</a>
                  {voce.sotto && (
                    <ul class="sottomenu">
                      {voce.sotto.map((s) => <li><a href={s.url}>{s.nome}</a></li>)}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </nav>
      </div>
    </header>
    <script>
      const bottone = document.querySelector<HTMLButtonElement>('.hamburger')!;
      bottone.addEventListener('click', () => {
        const aperto = bottone.getAttribute('aria-expanded') === 'true';
        bottone.setAttribute('aria-expanded', String(!aperto));
        document.body.classList.toggle('menu-aperto', !aperto);
      });
    </script>

    <main id="contenuto">
      <slot />
    </main>

    <footer class="piede">
      <div class="contenitore piede__griglia">
        <div>
          <img class="piede__logo" src="/uploads/2022/01/logo_menu-1.jpg" alt={sito.nome} width="397" height="149" />
          <p>{sito.indirizzo}<br />{sito.come_arrivare}</p>
        </div>
        <div>
          <h2>Contatti</h2>
          <p>
            Tel. <a href={`tel:${sito.telefono.replace(/\s/g, '')}`}>{sito.telefono}</a><br />
            <a href={`mailto:${sito.email}`}>{sito.email}</a><br />
            Consultorio: <a href={`mailto:${sito.email_consultorio}`}>{sito.email_consultorio}</a>
          </p>
          <p>{sito.social.map((s, i) => <>{i > 0 && ' · '}<a href={s.url} rel="noopener">{s.nome}</a></>)}</p>
        </div>
        <div>
          <h2>Link utili</h2>
          <ul>
            {sito.link_utili.map((l) => <li><a href={l.url} rel="noopener">{l.nome}</a></li>)}
          </ul>
        </div>
      </div>
      <div class="contenitore piede__fondo">
        <span>© {new Date().getFullYear()} {sito.nome}</span>
        <a href="/appuntamenti.ics">Calendario degli appuntamenti (.ics)</a>
      </div>
    </footer>
  </body>
</html>

<style>
  .salta { position: absolute; left: -9999px; top: 8px; background: var(--bordeaux); color: #fff; padding: 8px 12px; z-index: 100; }
  .salta:focus { left: 8px; }

  .intestazione { position: sticky; top: 0; z-index: 50; background: rgb(255 255 255 / .96); backdrop-filter: blur(6px); border-bottom: 1px solid var(--linea); }
  .intestazione__riga { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 76px; }
  .logo img { height: 58px; width: auto; }

  .menu { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: 4px; }
  .menu > li { position: relative; }
  .menu a {
    display: block; padding: 10px 12px; text-decoration: none;
    font: 600 0.78rem/1.2 var(--titoli); letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--inchiostro); border-radius: var(--raggio);
  }
  .menu a:hover, .menu a[aria-current='page'] { color: var(--bordeaux); }
  .menu > li > a[aria-current='page'] { box-shadow: inset 0 -2px 0 var(--bordeaux); border-radius: 0; }
  .sottomenu {
    list-style: none; margin: 0; padding: 8px; min-width: 220px;
    position: absolute; top: 100%; left: 0;
    background: #fff; border: 1px solid var(--linea); border-radius: var(--raggio);
    box-shadow: 0 12px 30px rgb(0 0 0 / .08);
    opacity: 0; visibility: hidden; transform: translateY(6px); transition: .15s;
  }
  .ha-sotto:hover .sottomenu, .ha-sotto:focus-within .sottomenu { opacity: 1; visibility: visible; transform: none; }
  .sottomenu a { text-transform: none; letter-spacing: 0; font-size: 0.9rem; font-weight: 500; }

  .hamburger { display: none; }
  @media (max-width: 1080px) {
    .hamburger {
      display: flex; flex-direction: column; justify-content: center; gap: 5px;
      width: 44px; height: 44px; padding: 10px; cursor: pointer;
      background: none; border: 1px solid var(--linea); border-radius: var(--raggio);
    }
    .hamburger span { height: 2px; background: var(--inchiostro); border-radius: 2px; }
    .navigazione { display: none; }
    :global(body.menu-aperto) .navigazione {
      display: block; position: absolute; left: 0; right: 0; top: 100%;
      background: #fff; border-bottom: 1px solid var(--linea);
      max-height: calc(100vh - 76px); overflow: auto; padding: 8px 16px 20px;
    }
    .menu { flex-direction: column; align-items: stretch; }
    .menu a { padding: 12px 4px; font-size: 0.85rem; }
    .menu > li > a[aria-current='page'] { box-shadow: none; }
    .sottomenu { position: static; opacity: 1; visibility: visible; transform: none; border: 0; box-shadow: none; padding: 0 0 0 16px; }
  }

  .piede { background: var(--inchiostro); color: #c9cbd0; font-size: 0.95rem; margin-top: 0; }
  .piede a { color: #fff; }
  .piede h2 { color: #fff; font-size: 0.8rem; letter-spacing: 0.14em; text-transform: uppercase; margin: 0 0 14px; }
  .piede__griglia { display: grid; gap: 40px; grid-template-columns: 1.2fr 1fr 1fr; padding: 64px 0 40px; }
  .piede__logo { width: 210px; filter: invert(1) grayscale(1); mix-blend-mode: screen; margin-bottom: 16px; }
  .piede ul { list-style: none; margin: 0; padding: 0; columns: 1; }
  .piede li { margin-bottom: 4px; }
  .piede__fondo { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; padding: 20px 0 28px; border-top: 1px solid rgb(255 255 255 / .12); font-size: 0.85rem; }
  @media (max-width: 760px) { .piede__griglia { grid-template-columns: 1fr; } }
</style>
